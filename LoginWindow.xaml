<Window x:Class="FlowerStore.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập hệ thống"
        SizeToContent="Height"
        MinHeight="340"
        Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8F4EE">
    <Grid Margin="24">
        <Border Padding="24"
                Background="#FFFDF9"
                BorderBrush="#E0D6C8"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.ColumnSpan="2"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#5A3825"
                           Text="Đăng nhập"/>

                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Margin="0,8,0,18"
                           Foreground="#7A5A46"
                           Text="Tài khoản mặc định: staff / 123456"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Tài khoản"/>
                <TextBox x:Name="UsernameTextBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Margin="0,0,0,12"
                         Text="staff"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,12" VerticalAlignment="Center" Text="Mật khẩu"/>
                <PasswordBox x:Name="PasswordBox"
                             Grid.Row="3"
                             Grid.Column="1"
                             Margin="0,0,0,12"
                             Password="123456"/>

                <TextBlock x:Name="ErrorTextBlock"
                           Grid.Row="4"
                           Grid.ColumnSpan="2"
                           Margin="0,0,0,14"
                           Foreground="#A1260D"
                           Text=""
                           TextWrapping="Wrap"/>

                <Button Grid.Row="5"
                        Grid.ColumnSpan="2"
                        Height="36"
                        Content="Đăng nhập"
                        Click="LoginButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
