<Window x:Class="FlowerStore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flower Store" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Background="#EEE">
            <Button Content="Show Flowers" Click="ShowFlowers_Click" Margin="5"/>
            <Button Content="Add Flower" Click="AddFlower_Click" Margin="5"/>
            <Button Content="Create Order" Click="CreateOrder_Click" Margin="5"/>
            <Button Content="Show Orders" Click="ShowOrders_Click" Margin="5"/>
        </StackPanel>
        <Grid Grid.Column="1">
            <DataGrid x:Name="dataGrid" AutoGenerateColumns="True"/>
        </Grid>
    </Grid>
</Window>